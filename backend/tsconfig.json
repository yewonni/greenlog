{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*", "express.d.ts"],
  "exclude": ["node_modules"],
  "ts-node": {
    "files": true
  }
}
